# systemd unit for the hosted viewer. Expects the binary at
# /usr/local/bin/google-ads-transparency-pp-cli, the mirror at
# /var/lib/metrifi-intelligence/data.db, and screenshots in the CLI's
# default cache dir for the service user.
[Unit]
Description=MetriFi Intelligence viewer
After=network.target

[Service]
User=intelligence
ExecStart=/usr/local/bin/google-ads-transparency-pp-cli serve \
  --open=false \
  --db /var/lib/metrifi-intelligence/data.db \
  --cta-url https://github.com/heyharmon/metrifi-intelligence \
  --cta-text "MetriFi Intelligence — get the Claude Code harness that builds this data"
Restart=on-failure

[Install]
WantedBy=multi-user.target
